{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "verdict", "confidence", "reason"],
        "properties": {
          "fingerprint": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[a-f0-9]+$"
          },
          "verdict": { "enum": ["CONFIRMED", "REJECTED"] },
          "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1200 }
        }
      }
    }
  }
}
