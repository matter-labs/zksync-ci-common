{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structural configuration contract. Runtime validation also checks profile existence, safe paths, supported globs and canonical source URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "profiles": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(languages|domains)/[a-z0-9-]+$" }
    },
    "context": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "allowedLockfileHosts": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "hostname",
        "maxLength": 253,
        "pattern": "^[a-z0-9-]+\\.[a-z0-9.-]+$"
      }
    },
    "allowedLockfileSources": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048,
        "description": "Canonical HTTPS repository URL without credentials, query, fragment, trailing slash or .git suffix. Runtime also checks URL normalization.",
        "pattern": "^https://[^/?#@]+/[^?#]+$",
        "not": { "pattern": "(?:\\.git|/)$" }
      }
    },
    "groupRoots": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "pathProfiles": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "profiles"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^(languages|domains)/[a-z0-9-]+$" }
          }
        }
      }
    },
    "regenerableArtifacts": {
      "type": "array",
      "maxItems": 20,
      "description": "Generated outputs that CI deterministically regenerates and verifies. Matching files are excluded from model review and reported as skipped. Runtime keeps lockfiles, submodule pointers, .github/ files and trusted context files in review.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "verifiedBy"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "verifiedBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The CI check that regenerates these outputs and fails on a mismatch."
          }
        }
      }
    }
  }
}
